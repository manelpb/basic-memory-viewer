# Copy to .env and adjust. .env is gitignored.
# basic-memory MCP SSE endpoint (the /mcp path is required).
MCP_URL=http://localhost:8000/mcp
# Default project shown.
BM_PROJECT=main
# Rows per page of the recent feed. Not a ceiling — the feed pages back.
# basic-memory caps page_size at 100, so anything higher is clamped.
RECENT_LIMIT=60
# How far back the recent feed reaches. basic-memory caps this at 1 year.
RECENT_TIMEFRAME=365d
# Brand name in the UI.
APP_TITLE=Memory
# Optional account name in the sidebar.
APP_USER=
